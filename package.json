{
	"name": "jtzl-bot-maze-assets",
	"version": "1.1.0",
	"description": "JTZL's Bot Maze plugin assets - JavaScript build system for admin analytics",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run typecheck && bun run build:js && bun run build:css && bun run verify:build",
		"build:js": "NODE_ENV=production bun run esbuild.config.js",
		"build:css": "postcss src/styles/admin.css -o build/jtzl-bm-admin.css && bun run scripts/hash-assets.js",
		"build:prod": "bun run build",
		"verify:build": "bun run scripts/verify-build.js",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"dev": "bun run dev:js & bun run dev:css",
		"dev:js": "NODE_ENV=development bun run -e \"const { startDevWatch } = require('./esbuild.config.js'); startDevWatch();\"",
		"dev:css": "bun run scripts/css-watch.js",
		"watch": "bun run dev",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"lint": "eslint src tests scripts --ext .js,.ts,.tsx",
		"lint:fix": "eslint src tests scripts --ext .js,.ts,.tsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:all": "prettier --write . && eslint . --ext .js,.ts,.tsx --fix",
		"prepare": "husky",
		"env:start": "npx -y @wordpress/env@11.0.0 start",
		"env:stop": "npx -y @wordpress/env@11.0.0 stop",
		"env:destroy": "npx -y @wordpress/env@11.0.0 destroy"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@testing-library/dom": "^10.4.1",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^25.5.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"@vitest/coverage-v8": "^2.1.9",
		"@vitest/ui": "^2.1.9",
		"@wordpress/eslint-plugin": "^17.13.0",
		"@wordpress/prettier-config": "^3.15.0",
		"autoprefixer": "^10.4.27",
		"chokidar": "^4.0.3",
		"cssnano": "^7.1.4",
		"dotenv": "^17.3.1",
		"esbuild": "^0.27.4",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"lint-staged": "^16.4.0",
		"postcss": "^8.5.8",
		"postcss-cli": "^11.0.1",
		"postcss-import": "^16.1.1",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	},
	"overrides": {
		"minimatch": ">=3.1.3",
		"brace-expansion": ">=1.1.13",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4",
		"esbuild": ">=0.25.0"
	},
	"engines": {
		"node": "20.x",
		"bun": ">=1.0.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"*.{css,json,md,yml,yaml}": [
			"prettier --write"
		],
		"*.php": [
			"vendor/bin/phpcbf --standard=phpcs.xml.dist --report=summary --"
		]
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"topojson-client": "^3.1.0",
		"world-atlas": "^2.0.2"
	}
}
